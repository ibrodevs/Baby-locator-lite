# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

require 'xcodeproj'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def firebase_ios_bundle_id
  plist_path = File.expand_path('Runner/GoogleService-Info.plist', __dir__)
  return nil unless File.exist?(plist_path)

  firebase_config = Xcodeproj::Plist.read_from_path(plist_path)
  bundle_id = firebase_config['BUNDLE_ID'].to_s.strip
  bundle_id.empty? ? nil : bundle_id
rescue StandardError => error
  Pod::UI.warn("Unable to read Firebase iOS bundle id: #{error.message}")
  nil
end

def sync_runner_project_settings
  bundle_id = firebase_ios_bundle_id
  unless bundle_id
    Pod::UI.warn('GoogleService-Info.plist has no BUNDLE_ID; keeping the existing Xcode bundle identifier.')
    return
  end

  project_path = File.expand_path('Runner.xcodeproj', __dir__)
  project = Xcodeproj::Project.open(project_path)
  changed = false

  project.targets.each do |target|
    next unless ['Runner', 'RunnerTests'].include?(target.name)

    target.build_configurations.each do |config|
      expected_bundle_id = target.name == 'Runner' ? bundle_id : "#{bundle_id}.RunnerTests"
      settings = config.build_settings

      if settings['PRODUCT_BUNDLE_IDENTIFIER'] != expected_bundle_id
        settings['PRODUCT_BUNDLE_IDENTIFIER'] = expected_bundle_id
        changed = true
      end

      if settings.key?('DEVELOPMENT_TEAM')
        settings.delete('DEVELOPMENT_TEAM')
        changed = true
      end

      unless settings['CODE_SIGN_STYLE'] == 'Automatic'
        settings['CODE_SIGN_STYLE'] = 'Automatic'
        changed = true
      end

      unless settings['IPHONEOS_DEPLOYMENT_TARGET'] == '14.0'
        settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
        changed = true
      end
    end
  end

  if changed
    project.save
    Pod::UI.puts "Synced Runner bundle identifier with Firebase: #{bundle_id}"
  end
end

def patch_flutter_webrtc_event_sink
  plugin_file = File.expand_path(
    File.join(
      __dir__,
      '.symlinks',
      'plugins',
      'flutter_webrtc',
      'ios',
      'Classes',
      'FlutterWebRTCPlugin.m',
    ),
  )
  return unless File.exist?(plugin_file)

  source = File.read(plugin_file)
  broken = <<~OBJC
    void postEvent(FlutterEventSink _Nonnull sink, id _Nullable event) {
        dispatch_async(dispatch_get_main_queue(), ^{
          sink(event);
        });
    }
  OBJC
  fixed = <<~OBJC
    void postEvent(FlutterEventSink _Nonnull sink, id _Nullable event) {
        FlutterEventSink retainedSink = [sink copy];
        if (!retainedSink) {
          return;
        }

        dispatch_async(dispatch_get_main_queue(), ^{
          retainedSink(event);
        });
    }
  OBJC
  return unless source.include?(broken)

  File.write(plugin_file, source.sub(broken, fixed))
  puts 'Patched flutter_webrtc iOS event sink lifetime bug'
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  patch_flutter_webrtc_event_sink
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Disable sandbox so framework copy scripts can run under Xcode.
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      # Keep all pods aligned with the application deployment target.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      # Bitcode is no longer used by modern iOS toolchains.
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      # Explicit Swift modules can break Firebase imports with some CocoaPods/Xcode combinations.
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
  end

  # Keep the native Runner project consistent with the Firebase iOS app and
  # portable between developer machines. The client only needs to select their
  # own Apple Development Team in Xcode after running `pod install`.
  sync_runner_project_settings
end
